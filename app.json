{
  "expo": {
    "name": "Hanna Sumo RC",
    "slug": "hanna-sumo-rc",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.chrisreactdev.hannasumorc",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/800ExtraBold/BarlowCondensed_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/900Black/BarlowCondensed_900Black.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/900Black_Italic/BarlowCondensed_900Black_Italic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      "./plugins/withBluetoothPermissions",
      "./plugins/withBluetoothClassicBuildConfig",
      "./plugins/withWindowsCMake",
      "expo-status-bar"
    ],
    "extra": {
      "expo-navigation-bar": {
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "b2111172-08ae-4e6c-96bd-b5c95c521df8"
      }
    },
    "owner": "xchrist"
  }
}
